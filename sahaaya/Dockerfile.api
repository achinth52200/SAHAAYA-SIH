# SAHAAYA API Gateway - Production Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies.
# Uses the deploy-only subset: the full requirements.txt pulls xgboost, sqlalchemy,
# asyncpg and redis, none of which the running API imports, and they add several
# minutes plus a compile step to every build.
COPY services/api-gateway/requirements-deploy.txt .
RUN pip install --no-cache-dir -r requirements-deploy.txt

# Copy application code
COPY services/api-gateway/ .
COPY services/nlp-ai-service/ ./nlp-ai-service/
COPY services/distress-engine/ ./distress-engine/
COPY services/explainability-service/ ./explainability-service/
COPY services/human-review-service/ ./human-review-service/

# Create non-root user
RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app
USER app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run application
# Single worker: each one loads its own copy of pandas, scikit-learn, the classifier
# and the dataset (~390 MB resident measured locally). Two workers would exceed the
# 512 MB free-tier limit and be OOM-killed on boot. Endpoints measure in
# milliseconds, so one worker is ample for demo traffic. Raise WEB_CONCURRENCY on a
# larger instance.
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-1}"]